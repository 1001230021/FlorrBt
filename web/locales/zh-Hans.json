  "codex": {
    "descriptions": {
      "beetle": "会主动追逐视野内的敌人，以身体碰撞造成伤害。别在它靠近时被挤进墙角。",
      "bandage_beetle": "会主动追击敌人的绷带甲虫。遭受致命伤害后会短暂维持不死状态，仍需提防它的碰撞。",
      "normal_ladybug": "平时四处游荡，受到攻击后会追击攻击者。外表温和，近身接触仍会造成伤害。",
      "mecha_flower": "装备齿轮花瓣的机械花朵，会与目标保持距离并进行远程攻击。稀有度越高，携带的齿轮通常越多。",
      "normal_flower": "会主动靠近并追击敌人的野生花朵。战斗时要留意它的身体和携带的花瓣。",
      "soldier_ant": "主动追击敌人的近战兵蚁，以身体接触造成伤害。多只同时靠近时更难躲避。",
      "soldier_fire_ant": "火蚁群中的近战士兵，会主动追击敌人。火蚁后产下的卵也会孵化为这种兵蚁。",
      "soldier_termite": "会主动追击敌人的白蚁士兵。具有灵能连接，可与附近同阵营、同样具有连接的生物分摊伤害。",
      "summoned_beetle": "由甲虫卵花瓣孵化的伙伴，会跟随主人并攻击附近敌人。它的行动范围受主人位置约束。",
      "summoned_soldier_ant": "由蚁卵花瓣召唤的兵蚁，会跟随主人并参与近战。主人远离时，它会尝试跟上。",
      "bee": "沿着摇摆的路线飞行，平时游荡，受击后追击攻击者。蜂蜜也能吸引它。",
      "hornet": "会调整与目标的距离并发射导弹。超级及以上稀有度拥有额外的攻击模式，不能只提防身体碰撞。",
      "bumble_bee": "会沿着摇摆的路线游荡，也会被蜂蜜吸引。飞行途中会周期性留下花粉。",
      "rock": "不会主动移动的障碍物，接触也可能造成伤害。超级及更高稀有度的石头受伤时可生成较低稀有度的石头。",
      "bubble": "不会主动追逐目标的泡泡，受到碰撞时会移动。超级及以上稀有度受伤时可生成较低稀有度的泡泡。",
      "crab": "先在目标附近绕行，再沿直线冲刺。冲刺方向确定后，及时横向避让比继续后退更有利。",
      "jellyfish": "周期性释放连锁闪电，攻击范围内的玩家花朵。放电不依赖它当前是否锁定某个目标。",
      "baby_ant": "只会随机游荡的幼蚁，不会主动追击敌人。普通蚁卵被打破时有机会出现。",
      "worker_ant": "平时游荡，受到攻击后会追击攻击者。这是野生工蚁；蚁国模式中负责搬运的工蚁有独立的行为。",
      "queen_ant": "战斗中会产卵支援，产下的卵经过等待后孵化为兵蚁。拖延战斗会让附近多出新的敌人。",
      "ant_hole": "受到伤害、生命值下降到不同阶段时，会分批释放蚂蚁。被击破后，剩余的蚁群仍会陆续出现。",
      "spider": "会主动追逐敌人。传说及以上稀有度在追击时会留下蛛网区域，使进入其中的敌人减速。",
      "sandstorm": "不断游荡的沙暴，以接触造成伤害。它不会像近战追击者那样锁定敌人，穿越它的路线时要留出空间。",
      "dummy": "固定在原地的训练假人，会恢复生命并统计玩家造成的伤害。持续攻击可收到伤害与每秒伤害反馈。",
      "dandelion": "受伤后会依次发射已装填的种子弹。被击败时会一次释放剩余种子，最后一击后也要注意躲避。",
      "ant_egg": "静止的普通蚁卵。被攻击打破时，有机会孵出同稀有度的幼蚁。",
      "fire_ant_egg": "静止的火蚁卵。被攻击打破时，有机会孵出同稀有度的幼火蚁。",
      "termite_egg": "具有灵能连接的白蚁卵，可参与附近同伴的伤害分摊。被打破时，有机会孵出幼白蚁。",
      "queen_ant_egg": "蚁后产下的卵。经过一段时间会自动孵化为兵蚁，并延续原来的阵营。",
      "queen_fire_ant_egg": "火蚁后产下的卵。经过一段时间会自动孵化为火兵蚁，并延续原来的阵营。",
      "baby_fire_ant": "只会随机游荡的幼火蚁，不会主动追击敌人。火蚁卵被打破时有机会出现。",
      "worker_fire_ant": "平时游荡，受到攻击后会追击攻击者。火蚁的接触伤害经过强化，不宜贴身停留。",
      "fire_queen_ant": "会在战斗中产下火蚁卵，卵随后自动孵化为火兵蚁。接近她时，也要留意周围刚孵出的士兵。",
      "baby_termite": "随机游荡的幼白蚁，不会主动追击敌人。它也具有灵能连接，可与附近相连的同伴分摊伤害。",
      "worker_termite": "平时游荡、受击后反击的白蚁工蚁。具有灵能连接，附近相连的同伴会影响它承受的伤害。",
      "termite_overmind": "具有灵能连接的白蚁首领，受击后会反击。超级、永恒、唯一和原初个体会周期性封禁附近敌对花朵的花瓣槽位。",
      "leaf_piece": "不会自行移动的叶片。切叶蚁士兵会寻找并搬起合适的叶片；被搬运时会随士兵移动。",
      "leafcutter_soldier": "会追击敌人，也会寻找合适的叶片并搬运。搬着叶片时，它的转向会受到限制。",
      "titan": "体型与属性经过强化的巨型花朵，受击后会反击。它会定期按当前可用的唯一花瓣更新装备，遭遇时的配装可能不同。",
      "firefly": "受击后会追击攻击者。低于超级时，闪电反击只响应生物的直接攻击，玩家花朵和花瓣除外；超级起可反击其他攻击来源，更高稀有度还会主动放电。永恒、唯一和原初个体在战斗中可召唤生物。",
      "magic_firefly": "使用魔法连锁闪电，反击和主动放电条件与普通萤火虫相同。永恒、唯一和原初个体在战斗中可召唤同稀有度的魔法萤火虫。",
      "firefly_larva": "由头部带领多个体节行动，会咬住敌人并持续施加毒素。头部和体节也能为经过的魔法闪电提供增伤。"
    }
  },
