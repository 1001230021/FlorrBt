<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <FlorrBtCurlBuild>$(ProjectDir)build\dependencies\curl-native</FlorrBtCurlBuild>
    <FlorrBtCurlSdk>$(ProjectDir)build\dependencies\curl-sdk\$(Configuration)</FlorrBtCurlSdk>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalIncludeDirectories>$(FlorrBtCurlSdk)\include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <AdditionalLibraryDirectories>$(FlorrBtCurlSdk)\lib;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalDependencies>libcurl_imp.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
  <Target Name="BuildFlorrBtCurl" BeforeTargets="ClCompile"
      Inputs="$(ProjectDir)cmake\RemoteTransportDependency.cmake;$(ProjectDir)cmake\curl\CMakeLists.txt;$(ProjectDir)tools\build_curl_sdk.ps1"
      Outputs="$(FlorrBtCurlSdk)\lib\libcurl_imp.lib;$(FlorrBtCurlSdk)\include\curl\curl.h;$(FlorrBtCurlSdk)\bin\libcurl.dll">
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(ProjectDir)tools\build_curl_sdk.ps1&quot; -BuildDirectory &quot;$(FlorrBtCurlBuild)&quot; -InstallDirectory &quot;$(FlorrBtCurlSdk)&quot; -Configuration &quot;$(Configuration)&quot;" />
  </Target>
  <Target Name="CopyFlorrBtCurl" AfterTargets="Build">
    <Copy SourceFiles="$(FlorrBtCurlSdk)\bin\libcurl.dll" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(FlorrBtCurlBuild)\curl-COPYING.txt" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
